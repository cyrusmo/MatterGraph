{
  "$id": "https://mattergraph.dev/schemas/0.1/quantity.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A scalar quantity whose unit is explicit at the JSON boundary.",
  "properties": {
    "unit": {
      "title": "Unit",
      "type": "string"
    },
    "value": {
      "title": "Value",
      "type": "number"
    }
  },
  "required": [
    "value",
    "unit"
  ],
  "title": "Quantity",
  "type": "object"
}
