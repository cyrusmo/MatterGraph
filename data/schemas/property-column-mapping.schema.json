{
  "$defs": {
    "PropertyMethod": {
      "enum": [
        "dft",
        "experimental",
        "model_predicted",
        "derived",
        "unknown"
      ],
      "title": "PropertyMethod",
      "type": "string"
    }
  },
  "$id": "https://mattergraph.dev/schemas/0.1/property-column-mapping.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Map one input column to a contextual, provenance-aware property.",
  "properties": {
    "column": {
      "title": "Column",
      "type": "string"
    },
    "method": {
      "$ref": "#/$defs/PropertyMethod",
      "default": "unknown"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "source": {
      "default": "local_file",
      "title": "Source",
      "type": "string"
    },
    "unit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unit"
    }
  },
  "required": [
    "column",
    "name"
  ],
  "title": "PropertyColumnMapping",
  "type": "object"
}
